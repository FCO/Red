use Test;
use Red;
use Red::Migration::Configuration;
use Red::Migration::Manager;

my @connection = (%*ENV<RED_DATABASE> // 'SQLite').words;
my $dialect = @connection.shift;
my %parameters = @connection.map({ do given .split('=', 2) { .[0] => val .[1] } }).Hash;
my $root = $*TMPDIR.add("red-locks-{$*PID}-{100000.rand.Int}"); $root.mkdir;
%parameters<database> = $root.add('lock.sqlite').Str if $dialect eq 'SQLite';
my $db = database $dialect, |%parameters;
my $other = database $dialect, |%parameters;
my $session;
if $dialect eq 'Pg' {
    $session = $other.dbh.db;
    $other = $other.new-connection($session);
}
LEAVE $session.finish if $session.defined;
my $*RED-DB = $db;
model LockedModel is table<migration_locked> { has Int $.id is serial }
my $manager = Red::Migration::Manager.new(:config(Red::Migration::Configuration.new(
    :models[LockedModel], :drivers[$dialect], :directory($root.add('migrations')),
    :connections{ default => $db })));
$db.execute('DROP TABLE IF EXISTS migration_locked');
$db.execute('DROP TABLE IF EXISTS red_migrations');
$manager.prepare('initial');
given $dialect {
    when 'SQLite' { $other.execute('BEGIN IMMEDIATE') }
    when 'Pg' { $other.execute('SELECT pg_advisory_lock(1380271181)') }
    when 'MySQL' { $other.execute("SELECT GET_LOCK(CONCAT('red_migrations:', SHA1(DATABASE())), 0)") }
}
dies-ok { $manager.apply }, 'another physical connection cannot migrate concurrently';
given $dialect {
    when 'SQLite' { $other.execute('ROLLBACK') }
    when 'Pg' { $other.execute('SELECT pg_advisory_unlock(1380271181)') }
    when 'MySQL' { $other.execute("SELECT RELEASE_LOCK(CONCAT('red_migrations:', SHA1(DATABASE())))") }
}
is $manager.apply, 1, 'migration succeeds after releasing the lock';
is $manager.apply, 0, 'executor releases its own lock after successful execution';
done-testing;
