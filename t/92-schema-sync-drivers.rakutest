use Test;
use Red;
my @config = (%*ENV<RED_DATABASE> // 'SQLite').split(' ');
my $backend = @config.shift;
my $*RED-DB = database $backend, |%(@config.map({ my ($k,$v)=.split('='); $k => val($v) }));
sub qn($name) { $*RED-DB.table-name-wrapper($name) }
sub sql(Str $text) { $*RED-DB.execute($text) }
model SyncV1 is table<sync_items> {
    has Int $.id is serial;
    has Str $.label is column;
}
model SyncV2 is table<sync_items> {
    has Int $.id is serial;
    has Str $.label is column;
    has Str $.extra is column{ :nullable };
}
model SyncV3 is table<sync_items> {
    has Int $.id is serial;
    has Str $.label is column;
}
model SyncBad is table<sync_items> {
    has Int $.id is serial;
    has Str $.label is column;
    has Str $.extra is column{ :nullable };
    has Str $.required is column;
}
schema(SyncV1).drop;
ok schema(SyncV1).plan.elems, 'Empty database has a creation plan';
lives-ok { schema(SyncV1).update }, "Create table on $backend";
is schema(SyncV1).plan.elems, 0, 'Created schema matches model';
sql("INSERT INTO {qn('sync_items')} (id,label) VALUES (7,'preserve')");
lives-ok { sql("INSERT INTO {qn('sync_items')} (label) VALUES ('generated')") },
    'Serial IDs are generated by tables created from the plan';
is sql("SELECT COUNT(*) AS c FROM {qn('sync_items')}").row<c>, 2,
    'The generated ID does not collide with the existing ID';
my @before = schema(SyncV2).plan;
ok @before.elems, 'Adding nullable column produces a plan';
lives-ok { schema(SyncV2).update }, 'Add nullable column';
is schema(SyncV2).plan.elems, 0, 'Updated schema matches model';
lives-ok { schema(SyncV2).update }, 'Second update is a no-op';
is sql("SELECT id FROM {qn('sync_items')} WHERE id=7").row<id>, 7, 'Existing ID and row survive';
throws-like { schema(SyncV3).update }, X::Red::Schema::DestructiveChange,
    'Dropping a column requires explicit opt-in';
lives-ok { my $statement = sql("SELECT extra FROM {qn('sync_items')}"); loop { my $row := $statement.row; last if $row =:= IterationEnd || !$row } }, 'Refused drop leaves column intact';
lives-ok { schema(SyncV3).update(:allow-destructive) }, 'Opt-in permits plain column removal';
is schema(SyncV3).plan.elems, 0, 'Schema matches after removal';
throws-like { schema(SyncBad).update }, X::Red::Schema::UnsupportedChange,
    'Unsupported non-null addition is rejected before any DDL';
is schema(SyncV3).plan.elems, 0, 'Rejected plan did not add its supported nullable column';
is sql("SELECT id FROM {qn('sync_items')} WHERE id=7").row<id>, 7, 'Rejected update preserves data';
model SyncUnique {
    has Int $.id is serial;
    has Str $.code is unique;
    has Str $.left is unique<pair>;
    has Str $.right is unique<pair>;
}
schema(SyncUnique).drop;
lives-ok { schema(SyncUnique).update }, 'Create simple and composite unique constraints';
is schema(SyncUnique).plan.elems, 0, 'Constraint introspection round-trips';
my $table=qn(SyncUnique.^table);
sql("INSERT INTO $table (id,code,{qn('left')},{qn('right')}) VALUES (1,'a','x','y')");
dies-ok { sql("INSERT INTO $table (id,code,{qn('left')},{qn('right')}) VALUES (2,'a','u','v')") }, 'Single unique is enforced';
dies-ok { sql("INSERT INTO $table (id,code,{qn('left')},{qn('right')}) VALUES (3,'b','x','y')") }, 'Composite unique is enforced';
# Each runner owns an isolated database.
done-testing;
