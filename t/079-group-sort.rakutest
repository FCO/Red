use Test;
use Red;

my $configured-driver = (%*ENV<RED_DATABASE> // 'SQLite').split(' ').head;
plan :skip-all("Group-sort is not validated for $configured-driver")
    unless $configured-driver eq any('SQLite', 'DuckDB');
model TestModel {
    has Str $.name is column;
    has Int $.count is column;
}

my $*RED-DEBUG          = $_ with %*ENV<RED_DEBUG>;
my $*RED-DEBUG-RESPONSE = $_ with %*ENV<RED_DEBUG_RESPONSE>;
my @conf                = (%*ENV<RED_DATABASE> // "SQLite").split(" ");
my $driver              = @conf.shift;
my $*RED-DB             = database $driver, |%( @conf.map: { do given .split: "=" { .[0] => val .[1] } } );

schema(TestModel).drop;
TestModel.^create-table;

TestModel.^create(:name<one>, :count(3));
TestModel.^create(:name<two>, :count(1));
TestModel.^create(:name<one>, :count(2));

# Bag aggregates group membership; ordering applies to rows within each group.
my $b = TestModel.^all.sort(*.count).classify(*.name).Bag;

is-deeply $b, bag(<one one two>), 'sort + classify preserves group counts';
is-deeply TestModel.^all.sort(*.count).classify(*.name)<one>.map(*.count).Array,
    [2, 3], 'group members retain explicit ordering';

done-testing;
