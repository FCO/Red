use Test;
use Red;
use Red::Migration::Configuration;
use Red::Migration::Manager;
use Red::Migration::Environment;
use Red::Migration::Storage;

temp %*ENV<RED_MIGRATION_ENV_TEST> = 'inherited';

my @connection = (%*ENV<RED_DATABASE> // 'SQLite').words;
my $driver = @connection.shift;
my %server = @connection.map({ do given .split('=', 2) { .[0] => val .[1] } }).Hash;
my $root = $*TMPDIR.add("red-environment-{$*PID}-{100000.rand.Int}");
model EnvUser is table<env_user> { has Int $.id is serial; has Str $.name is column }
my $manager = Red::Migration::Manager.new(:config(Red::Migration::Configuration.new(
    :models[EnvUser], :drivers[$driver], :directory($root), :test-servers{ $driver => %server })));
$manager.prepare('initial');
lives-ok { $manager.test }, 'applies, verifies, rolls back and reapplies in a fresh database';
my $program = 'use Red; use Red::Migration::Environment; '
    ~ 'die "missing inherited environment" unless %*ENV<RED_MIGRATION_ENV_TEST> eq "inherited"; '
    ~ 'my $*RED-DB = test-database(); '
    ~ 'die "missing database" unless $*RED-DB.defined; '
    ~ 'die "wrong schema" unless "env_user" eq any($*RED-DB.schema-reader.tables-names.List);';
lives-ok { $manager.test(:$driver, :command[$*EXECUTABLE.Str, '-e', $program]) },
    'child command receives the temporary connection and inherited environment';
dies-ok { $manager.test(:$driver, :command[$*EXECUTABLE.Str, '-e', 'exit 7']) },
    'child failures fail migration validation';
my $context;
{
    temp %*ENV<RED_MIGRATION_TEST> = 'caller-context';
    temporary-database('SQLite', {}, -> $db, $file, %parameters {
        $context = $file;
        is %*ENV<RED_MIGRATION_ENV_TEST>, 'inherited', 'temporary databases retain caller settings';
        ok !(%*ENV<RED_MIGRATION_TEST>:exists), 'nested provisioning clears the inherited test context';
        %*ENV<RED_MIGRATION_ENV_TEST> = 'local';
        True
    });
    is %*ENV<RED_MIGRATION_ENV_TEST>, 'inherited', 'provisioning does not change the caller environment';
    is %*ENV<RED_MIGRATION_TEST>, 'caller-context', 'provisioning preserves the caller test context';
}
ok !$context.e, 'removes the context and temporary SQLite database';
temporary-database('SQLite', {}, -> $db, $file, %parameters { $context = $file; True }, :keep);
ok $context.f && $context.parent.add('test.sqlite').f, 'keep retains the connection and database';
remove-tree($context.parent);
done-testing;
