use Test;
use Red;
use Red::Compiler::Regex;
use Red::AST::RegexMatch;
use Red::AST::Value;

my constant HAS-RAKUAST = $*CU.^name eq 'RakuAST::CompUnit';
CHECK red-compile if HAS-RAKUAST;
unless HAS-RAKUAST {
    plan :skip-all('Regex compilation needs the RakuAST frontend');
    exit;
}

my @configuration = (%*ENV<RED_DATABASE> // 'SQLite').split(' ');
my $backend = @configuration.shift;
my $*RED-DB = database $backend,
    |($backend eq 'SQLite' ?? { :use-experimental-regex } !! {}),
    |%(@configuration.map({
        my ($key, $value) = .split('=');
        $key => val($value)
    }));
my $*RED-FALLBACK = False;

my @texts = '', 'a', 'A', 'aa', 'aA', 'Aa', 'AA', 'ab', 'ba', 'bb', 'aaa',
    'aabb', 'abab', 'a1', '1a', '11', '_', ' ', "\n", "\n\n", "a\na",
    'éé', 'éÉ', 'ΩΩ', '🦋🦋';
my @patterns = q[/<same>/], q[/<?same>/], q[/<!same>/], q[/:i <same>/], q[/:i <!same>/],
    q[/^ <same> $/], q[/^ a <same> a $/], q[/^ a <!same> b $/],
    q[/:i ^ a <same> a $/], q[/:i ^ a <!same> a $/],
    q[/a <?before <same>> a/], q[/^ [a <same> a & aa] $/],
    q[/^ [a <!same> b & ab] $/], q[/<?digit> ./], q[/<!digit> ./],
    q[/<?wb> a/], q[/<!wb> a/], q[/<?alpha> ./], q[/<!alpha> ./], q[/a <?ww> ./], q[/a <!ww> ./],
    q[my regex pair { a a }; /<?pair> a/],
    q[my regex pair { a a }; /<!pair> a/],
    q[my regex wb { b }; /^ <?wb> a $/],
    q[my regex wb { b }; /^ <!wb> a $/],
    q[/^ (a) <same> $0 (b) $1 $/], q[/^ (a) <!same> (b) $0 $1 $/],
    q[/<same> $<same>/];

for @patterns -> $source {
    subtest $source => {
        my $quoted = $source.AST.statements[*-1].expression;
        my $regex = Red::Compiler::Regex.new.compile($quoted);
        my ($same, $intersection, $references, $classes) = False xx 4;
        $regex.walk(-> $part {
            $same = True if $part[0] eq 'same';
            $intersection = True if $part[0] eq 'intersection';
            $references = True if $part[0] eq 'backreference';
            $classes = True if $part[0] eq 'class';
        });
        if ($backend eq 'Pg' && $same)
            || ($backend eq 'MySQL' && $same && $intersection)
            || ($backend eq 'SQLite' && $references) {
            throws-like {
                my Int $*bind-counter = 0;
                $*RED-DB.translate(Red::AST::RegexMatch.checked(ast-value('aa'), $regex))
            }, X::Red::Compiler::Unsupported, :fatal(*.so),
                'Unavailable native semantics are an explicit diagnostic';
        } else {
            my $native = $quoted.compile-time-value;
            # SQLite shorthand classes deliberately use its native ASCII behavior.
            # Keep Unicode coverage for the binary same-character assertion.
            my @fixtures = $backend eq 'SQLite' && $classes
                ?? @texts.grep({ .ords.all < 128 }) !! @texts;
            for @fixtures -> $text {
                my Int $*bind-counter = 0;
                my $sql = $*RED-DB.translate(Red::AST::RegexMatch.checked(ast-value($text), $regex));
                is so($*RED-DB.execute("SELECT {$sql.key} AS matched", |$sql.value).row<matched>),
                    so($text ~~ $native), $text.raku;
            }
        }
    };
}

throws-like {
    Red::Compiler::Regex.new.compile(q[/<?unknown-rule>/].AST.statements[0].expression)
}, X::Red::Compiler::Unsupported, :fatal(*.so), 'Unknown named assertions are not executed';

model NamedAssertionRow {
    has Int $.id is serial;
    has Str $.name is column;
}
my $schema = schema(NamedAssertionRow);
$schema.drop.create;
LEAVE $schema.drop;
NamedAssertionRow.^create(:name($_)) for <aa aA ab 1a>;
is-deeply NamedAssertionRow.^all.grep({ .name ~~ /^ <?alpha> . <!digit> . $/ })
    .map(*.name).Array.Set, set('aA', 'aa', 'ab'),
    'Named lookaheads execute through the exported compiler';
if $backend eq 'Pg' {
    my $*RED-FALLBACK = True;
    throws-like { NamedAssertionRow.^all.grep({ .name ~~ /<same>/ }).elems },
        X::Red::Compiler::Unsupported, :fatal(*.so),
        'PostgreSQL same assertions cannot trigger an in-memory fallback';
} else {
    is-deeply NamedAssertionRow.^all.grep({ .name ~~ /:i <same>/ })
        .map(*.name).Array, ['aa'], 'Same compares exactly inside a compiled :i predicate';
}
done-testing;
